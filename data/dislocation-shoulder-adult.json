   {
    "title": "PITFALLS",
    "items": [
     {
      "t": "Avoid Hippocratic foot-in-axilla / forceful levering",
      "s": "msd:web",
      "d": 1
     },
     {
      "t": "Posterior dislocation (epileptic seizure, electrocution) is missed on AP — get Y / axillary view",
      "d": 1,
      "b": 1
     },
     {
      "t": "Document nerves BEFORE any attempt",
      "s": "msd:web",
      "d": 1,
      "b": 1
     },
     {
      "t": "Elderly: reduce sedative doses substantially",
      "s": "stg-adult:20.18",
      "b": 1
     }
    ]
   }
  ]
 }
