{
  "id": "vitals-adult",
  "type": "range",
  "short": "Vitals",
  "title": "Vital signs ruler — adult (NEWS2 bands)",
  "population": "adult",
  "age_range": "≥ 16 years, not pregnant",
  "setting": "casualty / ward",
  "hospital": "ANDH",
  "level": "district",
  "updated": "2026-10-31",
  "tags": [
    "vital signs",
    "early warning",
    "NEWS2",
    "sepsis",
    "deterioration",
    "adult",
    "range",
    "score"
  ],
  "formulas": [
    {
      "id": "news2",
      "name": "NEWS2",
      "expr": "RR + SpO2 + O2 + SBP + HR + CNS + T (points)",
      "range": [
        0,
        20
      ],
      "s": "NEWS2",
      "vars": {
        "RR": "points for Resp rate",
        "SPO2": "points for SpO₂ scale 1",
        "O2": "points for Air or O₂",
        "SBP": "points for Systolic BP",
        "HR": "points for Pulse",
        "CNS": "points for Consciousness",
        "T": "points for Temperature"
      },
      "d": true
    },
    {
      "id": "map",
      "name": "MAP",
      "expr": "(SBP + 2 × DBP) / 3",
      "units": "mmHg",
      "target": "aim > 65 in shock",
      "s": "HOSP:23.4",
      "vars": {
        "SBP": "systolic mmHg",
        "DBP": "diastolic mmHg"
      },
      "d": false
    },
    {
      "id": "shock_index",
      "name": "Shock index",
      "expr": "HR / SBP",
      "target": "> 1 = shocked (pulse > SBP)",
      "s": "MAT24:52",
      "vars": {
        "HR": "/min",
        "SBP": "mmHg"
      },
      "d": false
    },
    {
      "id": "pulse_pressure",
      "name": "Pulse pressure",
      "expr": "SBP − DBP",
      "units": "mmHg",
      "target": "narrow < 25 % of SBP",
      "s": "CLASSIC",
      "vars": {
        "SBP": "mmHg",
        "DBP": "mmHg"
      },
      "d": true
    }
  ],
  "related": [
    {
      "t": "SpO₂: give oxygen if < 94 %",
      "s": "HOSP:20.12",
      "d": false
    },
    {
      "t": "Hypertension: SBP ≥ 140 and/or DBP ≥ 90 on 2 occasions ≥ 2 days apart",
      "s": "PHC:4.15",
      "d": false
    },
    {
      "t": "Pregnancy: single SBP ≥ 160 and/or DBP ≥ 110 = acute severe hypertension → urgent management and referral",
      "s": "MAT24:103",
      "d": false
    },
    {
      "t": "Pregnancy: use the maternity early warning chart (EWC), not NEWS2",
      "s": "MAT24:62",
      "d": false
    },
    {
      "t": "RR < 12 after sedation = respiratory depression → oxygen, prepare to ventilate",
      "s": "HOSP:15.8",
      "d": false
    }
  ],
  "pearls": [
    {
      "t": "Score the trend, not one reading; recheck after each intervention",
      "s": "CLASSIC",
      "d": true
    },
    {
      "t": "Beta-blockers mask tachycardia; elderly may not mount a fever",
      "s": "CLASSIC",
      "d": true
    },
    {
      "t": "Count RR for a full 30–60 s — the most often missed sign",
      "s": "CLASSIC",
      "d": true
    }
  ],
  "discrepancies": [
    {
      "t": "No early-warning score (NEWS2/SATS TEWS) in the adult STG; NEWS2 bands are non-STG.",
      "s": "NEWS2",
      "d": true
    }
  ],
