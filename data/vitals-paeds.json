  "formulas": [
    {
      "id": "wt_apls",
      "name": "Weight estimate (1–10 y)",
      "expr": "(age + 4) × 2",
      "units": "kg",
      "s": "APLS",
      "vars": {
        "age": "years (1–10)"
      },
      "d": true
    },
    {
      "id": "sbp_min",
      "name": "Hypotension (1–10 y)",
      "expr": "SBP < 70 + 2 × age",
      "units": "mmHg",
      "s": "APLS",
      "vars": {
        "age": "years (1–10)"
      },
      "d": true
    },
    {
      "id": "sbp_min_inf",
      "name": "Hypotension (< 1 y)",
      "expr": "SBP < 70 (term neonate < 60)",
      "units": "mmHg",
      "s": "APLS",
      "d": true
    }
  ],
  "related": [
    {
      "t": "Tachypnoea: < 60 d > 60 · 2–12 mo > 50 · 1–5 y > 40 · 5–12 y > 25 /min",
      "s": "PAED:15.2",
      "d": false
    },
    {
      "t": "Oxygen if SpO₂ < 92 %",
      "s": "PAED:15.5",
      "d": false
    },
    {
      "t": "Compensated shock: cold peripheries, weak pulses, CRT ≥ 3 s, ↑ HR, altered LOC — hypotension is late and ominous",
      "s": "PAED:1.15",
      "d": false
    },
    {
      "t": "SATS triage: younger child < 3 y or < 95 cm; older child 3–12 y or 95–150 cm",
      "s": "SATS",
      "d": true
    }
  ],
  "pearls": [
    {
      "t": "Ranges are 'acceptable' for a calm child; crying/fever raise HR & RR",
      "s": "RCH",
      "d": true
    },
    {
      "t": "Use the right cuff: bladder ≈ 40 % of arm circumference",
      "s": "CLASSIC",
      "d": true
    }
  ],
  "discrepancies": [
    {
      "t": "Fast breathing: PAED STG 15.2 uses '>' (> 50, > 40); IMCI 2022 p.25 uses '≥' (≥ 50, ≥ 40). Card prints PAED STG; IMCI young infant > 60.",
      "s": "PAED:15.2",
      "d": false
    }
  ],
