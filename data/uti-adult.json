 "boxes": [
  {
   "title": "DISCHARGE TTO — not admitted",
   "items": [
    {
     "h": "Uncomplicated cystitis (non-pregnant woman)"
    },
    {
     "t": "Fosfomycin 3 g PO single dose",
     "s": "adultstg2026:7.18",
     "b": 1
    },
    {
     "t": "OR gentamicin 5 mg/kg IM single dose (not if renal impairment or pregnant)",
     "s": "adultstg2026:7.18",
     "b": 1
    },
    {
     "t": "OR nitrofurantoin 100 mg PO 6-hourly × 5 d",
     "s": "adultstg2026:7.19",
     "b": 1
    },
    {
     "h": "Complicated cystitis"
    },
    {
     "t": "Complicated cystitis (men, catheter, diabetes, abnormal tract): ciprofloxacin 500 mg PO 12-hourly × 7 d",
     "s": "adultstg2026:7.19",
     "b": 1
    },
    {
     "h": "Mild pyelonephritis (woman of reproductive age)"
    },
    {
     "t": "Pyelonephritis, woman of reproductive age, no admit criteria: ciprofloxacin 500 mg PO 12-hourly × 7–10 d (at least 7 d)",
     "s": "phcstg2026:8.11",
     "b": 1
    },
    {
     "t": "Ciprofloxacin + ACE-inhibitor / ARB: avoid if eGFR ≤ 30 or elderly; check renal function",
     "s": "adultstg2026:7.19"
    },
    {
     "h": "All"
    },
    {
     "t": "Paracetamol 500 mg–1 g PO 4–6-hourly as needed (max 4 g / 24 h)",
     "s": "phcstg2026:19.6"
    },
    {
     "t": "Fluids; return if fever, vomiting, flank pain",
     "d": 1
    }
   ]
  },
  {
   "title": "Admitted — antibiotics",
   "items": [
    {
     "t": "Normal renal function: gentamicin 6 mg/kg IV daily",
     "s": "adultstg2026:7.19",
     "b": 1
    },
    {
     "t": "Impaired renal function: ceftriaxone 1 g IV daily",
     "s": "adultstg2026:7.20",
     "b": 1
    },
    {
     "t": "Able to take oral: ciprofloxacin 500 mg PO 12-hourly (per MCS) — 7–10 d; renal impairment 7 d; eGFR < 10: 50% dose",
     "s": "adultstg2026:7.20",
     "b": 1
    },
    {
     "t": "Duration: fluoroquinolone 7 d · other antibiotics 14 d · complicated pyelonephritis 2–3 weeks",
     "s": "adultstg2026:7.19"
    },
    {
     "h": "Recurrent (> 3 / year)"
    },
    {
     "t": "Treat per MCS; prophylaxis cotrimoxazole 80/400 mg nocte × 6 months",
