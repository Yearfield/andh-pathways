 "decision": [
  {
   "t": "10. Diagnosis = NOT ABLE TO FEED / PSBI, dehydration with abnormal Na⁺ or renal function, or weight loss despite feeding → stabilise → REFER",
   "s": "imci2022:8",
   "b": 1
  },
  {
   "t": "11. ADMIT mother + baby (> 10% loss, not regained) — fix attachment, ≥ 8 feeds, top-up with EBM; continue on the feeding chart",
   "s": "imci2022:8",
   "b": 1
  }
 ],
