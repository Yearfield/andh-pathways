     "s": "paedstg2026:2.35",
     "b": 1
    }
   ],
   "manage": [
    {
     "t": "Vitamin K1 IV 2.5–10 mg daily",
     "s": "paedstg2026:2.36"
    },
    {
     "t": "FDP 20 mL/kg over 2 h if bleeding",
     "s": "paedstg2026:2.36"
    },
    {
     "t": "Dextrose 10% if HGT low",
     "s": "paedstg2026:2.36"
    }
   ],
   "refer": [
