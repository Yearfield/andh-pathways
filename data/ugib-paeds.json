     "b": 1
    }
   ],
   "refer": [
    {
     "t": "ALL — after resuscitation and octreotide, if available",
     "s": "paedstg2026:2.29",
     "b": 1
    }
   ]
  },
  {
   "dx": "Acute liver failure / liver coagulopathy",
