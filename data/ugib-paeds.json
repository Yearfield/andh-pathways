 "decision": [
  {
   "t": "10. Shock · massive bleed · varices · ongoing bleed → resuscitate, then REFER urgently · every true UGIB → REFER for endoscopy",
   "s": "paedstg2026:2.26"
  },
  {
   "t": "11. ADMIT while awaiting transfer · swallowed blood or small stopped bleed → observe 24 h",
   "d": 1
  }
 ],
 "differentials": [
  {
   "dx": "Bleeding oesophageal varices (portal hypertension)",
   "branch": "If variceal",
