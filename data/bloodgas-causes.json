  "interpretation_stg": [
    {
      "t": "Toxic alcohols: ↑AG + ↑osmolar gap metabolic acidosis",
      "s": "PAED:18.3"
    },
    {
      "t": "Ethylene glycol / methanol: severe HAGMA (latent 12–24 h for methanol)",
      "s": "HOSP:19.36"
    },
    {
      "t": "DKA: AG >20",
      "s": "HOSP:8.14"
    },
    {
      "t": "Salicylates: respiratory alkalosis (mild–mod) → metabolic acidosis (severe)",
      "s": "HOSP:19.19"
