 "indications": [
  {
   "h": "Treat as emergency",
   "col": 1,
   "items": [
    {
     "t": "Serum K⁺ >6.0 mmol/L",
     "s": "stg-adult:7.10",
     "b": 1
    },
    {
     "t": "Any K⁺ rise with ECG change: peaked T, wide QRS, brady / heart block",
     "s": "stg-adult:3.27"
    }
   ]
  },
  {
   "h": "Look for the cause",
   "col": 1,
   "items": [
    {
     "t": "AKI / CKD; ACE-i, ARB, spironolactone",
     "s": "stg-adult:7.9",
     "s_more": [
      "stg-adult:7.4",
      "stg-adult:1.11"
     ]
    },
    {
     "t": "Low Na + high K → think adrenal crisis",
     "s": "stg-adult:8.2"
    },
    {
     "t": "Tumour lysis; suxamethonium in burns / denervation",
     "s": "stg-adult:21.1",
     "s_more": [
      "stg-adult:12.3"
     ]
    }
   ]
  }
 ],
 "contraindications": [
  {
   "h": "Cautions",
   "col": 1,
   "items": [
    {
     "t": "Insulin → hypoglycaemia: glucose hourly for 6 h",
     "s": "stg-adult:7.10",
     "b": 1
    },
    {
     "t": "Calcium, insulin, salbutamol are short-term only — K must still be removed",
     "s": "stg-adult:7.10"
    },
    {
     "t": "Haemolysed sample: repeat (VBG) but treat now if ECG changed",
     "d": 1
    }
   ]
  },
  {
   "h": "Stop",
   "col": 1,
   "items": [
    {
     "t": "KCl, Ringer's lactate (K 4 mmol/L), ACE-i/ARB, spironolactone, NSAIDs",
     "d": 1
    }
   ]
  }
 ],
