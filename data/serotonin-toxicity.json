 "decision": [
  {
   "t": "10. Diagnosis = SEVERE serotonin toxicity (T > 39 °C, rigidity, seizures) or QTc with arrhythmia → stop agents, benzodiazepines, cool → REFER ICU",
   "s": "rch2021:web",
   "d": 1,
   "b": 1
  },
  {
   "t": "11. ADMIT / OBSERVE ≥ 12 h (deliberate, symptomatic, or child above threshold) — continue on the tox chart",
   "s": "rch2017:web",
   "d": 1,
   "b": 1
  }
 ],
