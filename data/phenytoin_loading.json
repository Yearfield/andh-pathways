 "interpretation_stg": [
  {
   "t": "Adult (10–30 min of seizure): phenytoin 20 mg/kg in 200 mL NaCl ≤ 50 mg/min, cardiac monitoring",
   "level": "red",
   "s": "HOSP:14.16"
  },
  {
   "t": "Arrhythmia / hypotension → stop, restart slower",
   "level": "amber",
   "s": "HOSP:14.16"
  },
  {
   "t": "Child: 20 mg/kg IV/IO in NaCl over 20 min, ≤ 3 mg/kg/min, cardiac monitor",
   "level": "red",
   "s": "PAED:13.9"
  },
  {
   "t": "Drug / toxin seizures (e.g. TCA, cocaine, INH) → benzodiazepine, not phenytoin",
   "level": "amber",
   "s": "HOSP:14.16"
  },
  {
   "t": "Already on phenytoin + possible toxicity → do not load",
   "level": "blue",
   "s": "HOSP:14.16"
  }
 ],
 "notes": [
  {
   "t": "Separate line; flush with NaCl before and after",
   "d": true,
   "s": "ANDH"
  },
  {
   "t": "Use within 1 h of mixing; discard if cloudy",
   "d": true,
   "s": "BNFC"
  },
  {
   "t": "Extravasation → tissue necrosis (purple glove)",
   "d": true,
   "s": "ANDH"
  },
  {
   "t": "Obese adult: dose on actual weight, many cap at 2 g",
   "d": true,
   "s": "ANDH"
  },
  {
   "t": "Benzodiazepine first (5 min), phenytoin second",
   "s": "HOSP:14.16"
  },
  {
   "t": "Still seizing after load → REFER, RSI",
   "s": "HOSP:14.16"
  }
 ]
