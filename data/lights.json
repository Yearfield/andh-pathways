      "type": "formula",
      "title": "Exudate if ANY one is true",
      "items": [
        {
          "name": "Protein ratio",
          "expr": "pleural protein ÷ serum protein > 0.5",
          "s": "LIGHT"
        },
        {
          "name": "LDH ratio",
          "expr": "pleural LDH ÷ serum LDH > 0.6",
          "s": "LIGHT"
        },
        {
          "name": "Pleural LDH",
          "expr": "> 2/3 × upper limit of normal serum LDH",
          "s": "LIGHT"
        }
