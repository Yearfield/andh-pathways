    {
      "type": "list",
      "title": "Pearls",
      "grow": true,
      "items": [
        {
          "t": "Send pleural protein, LDH, glucose, pH, cell count & differential, Gram/AFB/GeneXpert, ADA; serum protein + LDH same time",
          "s": "LIGHT"
        },
        {
          "t": "Light's misclassifies ~25% of diuretic-treated heart failure as exudate — serum–pleural albumin gradient >12 g/L favours transudate",
          "s": "LIGHT"
        },
        {
          "t": "Sensitivity ≈98% for exudate",
          "s": "LIGHT"
        }
      ]
    }
