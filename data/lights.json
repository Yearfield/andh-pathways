      "items": [
        {
          "t": "Tube drainage if pleural pH <7.2, bacteria on Gram stain/culture, or frank pus",
          "s": "HOSP:16.18",
          "level": "red"
        },
        {
          "t": "Lymphocytic exudate in a high-TB-burden area → empiric TB treatment",
          "s": "HOSP:16.21",
          "level": "amber"
        },
        {
          "t": "Drain max 1 L at a time; TB empyema needs an intercostal drain",
          "s": "HOSP:16.21",
          "level": "amber"
        },
        {
          "t": "Children: Light's criteria (calculator) for pleural fluid",
          "s": "PAED:15.13",
          "level": "amber"
        }
