     "s": "adultstg2026:1.23",
     "d": 1
    }
   ],
   "refer": [
    {
     "t": "ALL — immediate repair if strangulation suspected",
     "s": "wseshernia2017:Surg",
     "b": 1
    }
   ]
  },
  {
   "dx": "Adhesive small-bowel obstruction",
   "branch": "If adhesive / partial",
   "features": [
    {
     "t": "Previous abdominal surgery; colicky pain, vomiting, distension",
     "s": "wsesasbo2017:Dx"
    }
   ],
   "confirm": [
    {
     "t": "Ultrasound; REFER for CT with water-soluble contrast",
     "s": "wsesasbo2017:Dx"
    }
   ],
   "manage": [
    {
     "t": "Nil by mouth, NG decompression, fluids, electrolytes",
     "s": "wsesasbo2017:NOM",
     "b": 1
    },
    {
     "t": "Non-operative trial up to 72 h if no peritonitis / strangulation",
     "s": "wsesasbo2017:NOM"
    }
   ],
   "refer": [
    {
     "t": "Discuss all; operate if peritonitis, strangulation, ischaemia or failed trial",
     "s": "wsesasbo2017:Surg",
     "b": 1
    }
   ]
  },
  {
   "dx": "Peritonitis / perforation (incl. appendicitis)",
   "branch": "If surgical",
