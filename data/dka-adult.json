     "k": "value"
    },
    {
     "t": "Anion gap = Na − (Cl + HCO₃): > 20 = DKA",
     "s": "stgah:8.14"
    },
    {
     "t": "Osmolarity = 2(Na + K) + glucose + urea: > 320 = HHS",
     "s": "stgah:8.14"
    },
    {
     "t": "K⁺ < 3.5: add 40 mmol/L · 3.5–5.5: 20 mmol/L · > 5.5: none",
