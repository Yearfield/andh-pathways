 "interpretation_stg": [
  {
   "t": "Iron ingested > 60 mg/kg → whole bowel irrigation + desferrioxamine 15 mg/kg/h; REFER high care",
   "level": "red",
   "s": "PAED:18.13"
  },
  {
   "t": "High risk: drowsy, acidosis, shock, GI bleed, or serum Fe > 90 µmol/L",
   "level": "red",
   "s": "PAED:18.12"
  },
  {
   "t": "Medium: symptoms + serum Fe > 60 µmol/L → admit, chelate, NaCl 20 mL/kg",
   "level": "amber",
   "s": "PAED:18.12"
  },
  {
   "t": "Low: no GI symptoms, well 6 h, ≤ 20 mg/kg → discharge",
   "level": "green",
   "s": "PAED:18.12"
  },
  {
   "t": "Anaemia: Hb ≤ 7, symptomatic, failure, organomegaly, bleeding, > 5 y → refer",
   "level": "amber",
   "s": "PHC:3.2"
  },
  {
   "t": "Ferritin low: < 12 µg/L (< 5 y), < 15 (≥ 5 y); with infection < 30 / < 70",
   "level": "blue",
   "d": true,
   "s": "WHOFER"
  }
 ],
 "notes": [
  {
   "t": "PHC < 5 y: 1–2 mg/kg 8-hourly, Hb at 14 days",
   "s": "PHC:3.3"
  },
  {
   "t": "Continue 3–4 wk (PAED) / 3 mo (PHC) after Hb normal",
   "s": "PAED:3.11"
  },
  {
   "t": "Give with meals, not with milk or tea",
   "s": "PHC:3.3"
  },
  {
   "t": "Deworm: 1–2 y mebendazole 100 mg 12-hourly × 3 d; > 2 y 500 mg once",
   "s": "PAED:3.11"
  },
  {
   "t": "Ferritin rises in infection — check CRP",
   "d": true,
   "s": "WHOFER"
  },
  {
   "t": "FeSO₄ compound: 65 mg (PAED 3.10) vs 55 mg (PAED 18.12)",
   "s": "PAED:3.10"
  }
 ]
