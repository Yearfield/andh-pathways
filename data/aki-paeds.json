   ],
   "confirm": [
    {
     "t": "Ultrasound size, Ca, PO₄, ALP, Hb",
     "s": "paedstg2026:6.22",
     "b": 1
    }
   ],
   "manage": [
    {
     "t": "Treat the acute illness, then CKD (child) pathway",
     "s": "paedstg2026:6.21"
    }
   ],
   "refer": [
    {
     "t": "Y — all children with CKD",
     "s": "paedstg2026:6.26",
     "b": 1
    }
   ]
  }
