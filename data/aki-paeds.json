 "differentials": [
  {
   "dx": "Septic shock / sepsis",
   "branch": "If pre-renal / shock",
   "features": [
    {
     "t": "Fever, rash, cold peripheries, CRT ≥ 3 s",
     "s": "paedstg2026:1.15"
    }
   ],
   "confirm": [
    {
     "t": "Blood culture, FBC, HGT",
     "s": "paedstg2026:6.17",
     "b": 1
    }
   ],
   "manage": [
    {
     "t": "NaCl 0.9% or Ringer's 10 mL/kg rapidly; review every 15 min",
     "s": "paedstg2026:1.17"
    }
   ],
   "refer": [
    {
     "t": "Y if shock persists after 40 mL/kg (inotropes = ICU)",
     "s": "paedstg2026:1.17",
     "b": 1
    }
   ]
  },
  {
   "dx": "Dehydration (diarrhoea, vomiting)",
   "branch": "If pre-renal / shock",
   "features": [
    {
     "t": "Losses, poor intake, shock signs",
     "s": "paedstg2026:6.16"
    }
   ],
   "confirm": [
    {
     "t": "FeNa < 1%; urine osmolality > 320 (invalid after furosemide)",
     "s": "paedstg2026:6.16",
     "b": 1
    }
   ],
   "manage": [
    {
     "t": "Shock: NaCl 0.9% or Ringer's 20 mL/kg rapidly",
     "s": "paedstg2026:1.16"
    },
    {
     "t": "Replace losses: NaCl 0.9%/dextrose 5% or ORS",
     "s": "paedstg2026:6.18"
    }
   ],
   "refer": [
    {
     "t": "If oliguria persists once rehydrated",
     "d": 1
    }
   ]
  },
  {
   "dx": "Haemolytic uraemic syndrome",
   "branch": "",
   "features": [
    {
     "t": "Diarrhoea / dysentery, pallor, purpura, fever, neuro signs",
     "s": "paedstg2026:3.22"
    }
   ],
   "confirm": [
    {
     "t": "FBC + smear, platelets, U&E, INR / PTT, stool STEC, blood culture, HIV",
     "s": "paedstg2026:3.23",
     "b": 1
    }
   ],
   "manage": [
    {
     "t": "Infection: ceftriaxone 50–80 mg/kg IV daily",
     "s": "paedstg2026:3.23"
    },
    {
     "t": "Platelets only on haematologist advice",
     "s": "paedstg2026:3.23"
    }
   ],
   "refer": [
    {
     "t": "Y — all: early transfer to regional centre",
     "s": "paedstg2026:3.23",
     "b": 1
    }
   ]
  },
  {
   "dx": "Acute nephritic syndrome (post-streptococcal GN)",
   "branch": "If nephritic / GN",
   "features": [
    {
     "t": "Brown urine, puffy face, hypertension, little urine",
     "s": "phcstg2026:8.8"
    },
    {
     "t": "Sore throat / skin sores 1–3 weeks before",
     "d": 1
    }
   ],
   "confirm": [
    {
     "t": "Dipstick blood + protein; RBC casts",
     "s": "paedstg2026:6.16",
     "b": 1
    }
   ],
   "manage": [
    {
     "t": "Fluid: insensible + previous 24-h urine",
     "s": "paedstg2026:6.18"
    },
    {
     "t": "Furosemide 1–2 mg/kg IV over 5 min",
     "s": "paedstg2026:4.35"
    }
   ],
   "refer": [
    {
     "t": "Y if severe hypertension, overload or persisting",
     "s": "paedstg2026:4.36",
     "b": 1
    }
   ]
  },
  {
   "dx": "Pyelonephritis / UTI",
   "branch": "If obstruction or UTI",
   "features": [
    {
     "t": "Fever, loin pain, leucocytes + nitrites",
     "s": "paedstg2026:6.16"
    }
   ],
   "confirm": [
    {
     "t": "Urine culture; renal ultrasound",
     "s": "paedstg2026:6.6",
     "b": 1
    }
   ],
   "manage": [
    {
     "t": "Cefotaxime 50 mg/kg IV 8-hourly; no aminoglycosides",
     "s": "paedstg2026:6.7"
    }
   ],
   "refer": [
    {
     "t": "If no response at 24 h → specialist",
     "s": "paedstg2026:6.7"
    }
   ]
  },
  {
   "dx": "Obstruction (PUV, congenital, stones)",
   "branch": "If obstruction or UTI",
   "features": [
    {
     "t": "Palpable bladder, poor stream (boys), antenatal anomaly",
     "s": "paedstg2026:6.16"
    }
   ],
   "confirm": [
    {
     "t": "Ultrasound kidneys + bladder (on site)",
     "s": "paedstg2026:6.16",
     "b": 1
    }
   ],
   "manage": [
    {
     "t": "Urinary catheter; watch for polyuria",
     "d": 1
    }
   ],
   "refer": [
    {
     "t": "Y — paediatric surgery / urology",
     "d": 1,
     "b": 1
    }
   ]
  },
  {
   "dx": "Nephrotoxic medicines",
   "branch": "",
   "features": [
    {
     "t": "NSAIDs, aminoglycosides, vancomycin, cough mixtures, contrast",
     "s": "paedstg2026:6.17"
    }
   ],
   "confirm": [
    {
     "t": "Medicine history; creatinine trend",
     "s": "paedstg2026:6.17"
    }
   ],
   "manage": [
    {
     "t": "Stop; avoid all nephrotoxics",
     "s": "paedstg2026:6.17"
    }
   ],
   "refer": [
    {
     "t": "If a dialysis indication develops",
     "s": "paedstg2026:6.19"
    }
   ]
  },
  {
   "dx": "Acute-on-chronic CKD",
   "branch": "",
   "features": [
    {
     "t": "Poor growth, polyuria, anaemia, small kidneys",
     "s": "paedstg2026:6.21"
