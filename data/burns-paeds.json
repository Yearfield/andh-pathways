      "type": "stg",
      "title": "Major burns — admit / refer",
      "items": [
        {
          "t": "Partial thickness >10% or full thickness >3%",
          "s": "PAED:1.23",
          "level": "red"
        },
        {
          "t": "Head, face, hands, feet, perineum; circumferential; inhalation; electrical",
          "s": "PAED:1.23",
          "level": "red"
        },
        {
          "t": "Neonates; comorbid injuries",
          "s": "PAED:1.23",
          "level": "red"
        },
        {
          "t": "Minor = partial thickness <10% in a child >1 year",
          "s": "PAED:1.23",
          "level": "green"
        }
      ]
    },
    {
      "type": "stg",
      "title": "SA STG — management",
      "grow": true,
      "items": [
        {
          "t": "Soak in cold water for not more than 20 min; oxygen in all burns >10% or possible CO poisoning",
          "s": "PAED:1.22",
          "level": "amber"
        },
        {
          "t": "Child's palm = 1% TBSA; adult percentages from age 9 (plus 1% perineum)",
          "s": "PAED:1.24",
          "level": "amber"
        },
        {
          "t": "NG tube on free drainage in all burns >10%; start enteral feeds within 6 h",
          "s": "PAED:1.25",
          "level": "amber"
        },
        {
          "t": "Stop resuscitation fluids if UO >1–2 mL/kg/h or base excess better than −4",
          "s": "PAED:1.27",
          "level": "green"
        },
        {
          "t": "Hb <7 g/dL: packed red cells 10 mL/kg over 3 h; symptomatic hypoalbuminaemia: albumin 20% 2 g/kg/day",
          "s": "PAED:1.27",
          "level": "amber"
        }
      ]
    }
  ],
