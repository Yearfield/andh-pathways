 "boxes": [
  {
   "title": "Analgesia · sedation",
   "items": [
    {
     "h": "Simple — give regularly"
    },
    {
     "t": "Paracetamol 15 mg/kg PO 6-hourly (3 mo–12 y), max 90 mg/kg/d or 4 g",
     "s": "paed2023:20.8"
    },
    {
     "t": "+ Ibuprofen 5–10 mg/kg PO 6–8-hourly with food, max 40 mg/kg/d (> 3 mo)",
     "s": "paed2023:20.9"
    },
    {
     "h": "Opioid"
    },
    {
     "t": "Morphine PO > 12 mo: 0.2–0.4 mg/kg 4–6-hourly",
     "s": "paed2023:20.9"
    },
    {
     "t": "Morphine IV 1–12 y: 0.1–0.2 mg/kg, small doses every 5–10 min to effect",
     "s": "paed2023:20.10"
    },
    {
     "t": "Fentanyl intranasal 1–2 mcg/kg (preferred for procedures)",
     "s": "paed2023:20.18"
    },
    {
     "t": "Naloxone 10 mcg/kg IV/IM for opioid respiratory depression",
     "s": "paed2023:20.11"
    },
    {
     "h": "Procedural sedation"
    },
    {
     "t": "Ketamine IV 0.25–1 mg/kg · intranasal 5 mg/kg · IM 2–4 mg/kg",
     "s": "paed2023:20.18"
    },
    {
     "t": "Lidocaine (blocks): max 3 mg/kg",
     "s": "phc2024:21.66"
    }
   ]
  },
  {
   "title": "Open fracture · tetanus",
   "items": [
    {
     "h": "Antibiotic — start within 1 h",
     "s": "ob:1004",
     "d": 1
    },
    {
     "t": "Cefazolin 30 mg/kg IV 8-hourly (max 2 g)",
     "s": "paed2023:11.2",
     "b": 1,
     "d": 1
    },
    {
     "t": "Gustilo III: add gentamicin 6 mg/kg IV daily",
     "s": "paed2023:11.3",
     "d": 1
    },
    {
     "t": "Penicillin anaphylaxis: clindamycin 6 mg/kg IV",
     "s": "paed2023:11.2"
    },
    {
     "t": "Continue 24 h after wound closure (48 h for type III if closure delayed)",
     "s": "ob:1004",
     "d": 1
    },
    {
     "h": "Tetanus"
    },
    {
     "t": "Toxoid 0.5 mL IM unless booster in the last 5 years",
     "s": "paed2023:8.36"
    },
    {
     "t": "Penetrating wound, not fully immunised: tetanus immunoglobulin < 5 y 75 IU · 5–10 y 125 IU · > 10 y 250 IU",
     "s": "paed2023:8.36"
    }
   ]
  },
  {
   "title": "Stop · escalate",
   "items": [
    {
     "h": "Compartment syndrome",
     "s": "ob:1001"
    },
    {
     "t": "Pain out of proportion, more analgesia needed, pain on passive stretch, tense compartment — pulse often still present",
     "s": "ob:1001",
     "d": 1
    },
    {
     "t": "Split cast to skin, heart level, EMERGENCY REFER",
     "s": "ob:1001",
     "b": 1,
     "d": 1
    },
    {
     "h": "Supracondylar"
    },
    {
     "t": "Hand turns white/pulseless → EMERGENCY REFER",
     "s": "ob:4007",
     "d": 1
    },
    {
     "h": "Cast problem"
    },
    {
     "t": "Tight, wet, cracked, rubbing, smell → split/replace",
     "d": 1
    },
    {
     "h": "Opioid"
    },
    {
     "t": "Drowsy, slow breathing → stop opioid, oxygen, naloxone",
     "s": "paed2023:20.11"
    },
    {
     "h": "Safeguarding"
    },
    {
     "t": "New bruises, story changes, caregiver concern → social worker, report",
     "s": "ob:4001",
     "d": 1
    },
    {
     "h": "On any deterioration"
    },
    {
     "t": "Hb · FBC · U&E · VBG",
     "b": 1,
     "d": 1
    }
   ]
  }
