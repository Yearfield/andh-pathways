    },
    {
     "t": "Agitation / confusion / ↓LOC, pallor, tachycardia",
     "s": "stg-paed:1.15"
    },
    {
     "t": "Hypotension is a late, ominous sign",
     "s": "stg-paed:1.15"
    }
   ]
  },
  {
   "h": "Types",
   "col": 1,
   "items": [
    {
     "t": "Hypovolaemic (dehydration, haemorrhage), septic, cardiogenic, obstructive, neurogenic",
     "s": "stg-paed:1.15"
    }
   ]
  }
 ],
 "contraindications": [
  {
   "h": "Use a different card / dose",
