    {
     "t": "Diarrhoeal dehydration with shock: 10 mL/kg over 20 min (Dehydration card)",
     "s": "stg-paed:2.11"
    },
    {
     "t": "Cardiogenic: inotropes, no repeated boluses; high care",
     "s": "stg-paed:1.17"
    },
    {
     "t": "Neonate → Neonatal card",
     "d": 1
    }
