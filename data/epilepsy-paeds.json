 "boxes": [
  {
   "title": "ASM doses (per kg)",
   "items": [
    {
     "t": "Lamotrigine 0.2 mg/kg/dose daily → 1–5 mg/kg/dose 12–24-hourly (2-weekly steps)",
     "s": "paedstg2026:13.25"
    },
    {
     "t": "Levetiracetam 1–< 6 m: 7 → 21 mg/kg/dose 12-hourly · 6 m–< 4 y: 10 → 25 · 4–12 y: 10 → 30 (steps every 2 wk)",
     "s": "paedstg2026:13.25"
    },
    {
     "t": "Carbamazepine 5 mg/kg/day → +2 mg/kg/day 2-weekly; usual 10–20 (max 20) mg/kg/day",
     "s": "paedstg2026:13.26"
    },
    {
     "t": "Valproate 5 mg/kg/dose 8–12-hourly → 20–30 mg/kg/day (max 40)",
     "s": "paedstg2026:13.26"
    },
    {
     "t": "Phenobarbital 3–5 mg/kg at night (< 6 m / severe ID)",
     "s": "paedstg2026:13.26"
    }
