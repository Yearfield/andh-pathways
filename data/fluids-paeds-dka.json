     "b": 1
    },
    {
     "t": "Usually 4–12 h into treatment; ~80% mortality",
     "s": "stg-paed:7.18"
    },
    {
     "t": "Higher risk: high urea, PCO₂ <2.7 kPa",
     "s": "stg-paed:7.18"
