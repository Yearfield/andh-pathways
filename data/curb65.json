      "title": "SA STG",
      "items": [
        {
          "t": "Severe pneumonia = ≥2 of: confusion/↓LOC, RR ≥30, SBP <90, DBP <60, age >65",
          "s": "PHC:17.26",
          "level": "red",
          "c": "STG uses DBP <60 (CURB-65: ≤60)"
        },
        {
          "t": "Severe: oxygen to SpO₂ 92%; ceftriaxone 1 g IV/IM single dose before referral",
          "s": "PHC:17.26",
          "level": "red"
        },
        {
          "t": "Refer if any: confusion/↓LOC, cyanosis, RR ≥30, SBP <90, DBP <60",
          "s": "PHC:17.25",
          "level": "amber"
        },
        {
          "t": "Hospital: severe pneumonia = cyanosis, confusion, hypotension or RR >30",
          "s": "HOSP:16.16",
          "level": "red"
        },
        {
          "t": "IV → oral switch when haemodynamically stable, RR <25 and T <37.8 °C",
          "s": "HOSP:16.16",
          "level": "green"
        }
      ]
    },
    {
      "type": "list",
      "title": "Pearls",
      "grow": true,
      "items": [
        {
          "t": "Score supports, not replaces, judgement — hypoxia, comorbidity (HIV, TB) and social factors also decide admission",
          "s": "CURB65"
        },
        {
          "t": "CRB-65 is for settings without urea results",
          "s": "CURB65"
        },
        {
          "t": "Underestimates severity in young patients with sepsis — check lactate/SpO₂",
          "s": "CURB65"
        }
      ]
    }
