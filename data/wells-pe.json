  "components": [
    {
      "key": "PE1",
      "t": "Clinical signs/symptoms of DVT (min. leg swelling + pain on palpation of deep veins)",
      "points": {
        "wells": 3,
        "simplified": 1
      },
      "s": "NICE",
      "d": true
    },
    {
      "key": "PE2",
      "t": "Alternative diagnosis less likely than PE",
      "points": {
        "wells": 3,
        "simplified": 1
      },
      "s": "NICE",
      "d": true
    },
    {
      "key": "PE3",
      "t": "Heart rate >100 bpm",
      "points": {
        "wells": 1.5,
        "simplified": 1
      },
      "s": "NICE",
      "d": true
    },
    {
      "key": "PE4",
      "t": "Immobilisation >3 days or surgery in previous 4 weeks",
      "points": {
        "wells": 1.5,
        "simplified": 1
      },
      "s": "NICE",
      "d": true
    },
    {
      "key": "PE5",
      "t": "Previous DVT/PE",
      "points": {
        "wells": 1.5,
        "simplified": 1
      },
      "s": "NICE",
      "d": true
    },
    {
      "key": "PE6",
      "t": "Haemoptysis",
      "points": {
        "wells": 1,
        "simplified": 1
      },
      "s": "NICE",
      "d": true
    },
    {
      "key": "PE7",
      "t": "Malignancy (on treatment, treated in last 6 months, or palliative)",
      "points": {
        "wells": 1,
        "simplified": 1
      },
      "s": "NICE",
      "d": true
    }
  ],
  "formulas": [
    {
      "id": "wells_pe",
      "name": "Wells PE",
      "expr": "Sum of points (0–12.5)",
      "range": [
        0,
        12.5
      ],
      "s": "NICE",
      "d": true
    },
    {
      "id": "wells_pe_simplified",
      "name": "Simplified Wells PE",
      "expr": "1 point per item (0–7)",
      "range": [
        0,
        7
      ],
      "s": "GIBSON",
      "d": true
    },
    {
      "id": "ddimer_age_adjusted",
      "name": "Age-adjusted D-dimer cut-off (age >50)",
      "expr": "cut-off (µg/L FEU) = age × 10",
      "vars": {
        "age": "years"
      },
      "units": "µg/L FEU",
      "notes": "use if assay cut-off is 500 µg/L FEU",
      "s": "ADJUST",
      "d": true
    }
  ],
  "interpretation": [
    {
      "version": "wells",
      "scheme": "three-tier",
      "bands": [
        {
          "min": 0,
          "max": 1.5,
          "label": "Low (<2)",
          "risk": "PE ≈1.3%",
          "level": "green"
        },
        {
          "min": 2,
          "max": 6,
          "label": "Moderate (2–6)",
          "risk": "PE ≈16%",
          "level": "amber"
        },
        {
          "min": 6.5,
          "max": 12.5,
          "label": "High (>6)",
          "risk": "PE ≈38%",
          "level": "red"
        }
      ],
      "s": "WELLS-PE",
      "d": true
    },
    {
      "version": "wells",
      "scheme": "two-level (modified)",
      "bands": [
        {
          "min": 0,
          "max": 4,
          "label": "PE unlikely (≤4)",
          "level": "green"
        },
        {
          "min": 4.5,
          "max": 12.5,
          "label": "PE likely (>4)",
          "level": "red"
        }
      ],
      "s": "NICE",
      "d": true
    },
    {
      "version": "simplified",
      "scheme": "two-level",
      "bands": [
        {
          "min": 0,
          "max": 1,
          "label": "PE unlikely (0–1)",
          "level": "green"
        },
        {
          "min": 2,
          "max": 7,
          "label": "PE likely (≥2)",
          "level": "red"
        }
      ],
      "s": "GIBSON",
      "d": true
    }
  ],
  "next_steps": [
    {
      "if": "PE likely (>4)",
      "level": "red",
      "steps": [
        "CTPA immediately if possible",
        "If CTPA delayed → interim therapeutic anticoagulation",
        "CTPA negative + DVT suspected → proximal leg vein ultrasound"
      ],
      "s": "NICE",
      "d": true
    },
    {
      "if": "PE unlikely (≤4)",
      "level": "green",
      "steps": [
        "D-dimer (result within 4 h); anticoagulate if delayed",
        "D-dimer positive → CTPA (as for 'likely')",
        "D-dimer negative → PE excluded; stop anticoagulation"
      ],
      "s": "NICE",
      "d": true
    }
  ],
  "perc": {
    "when": "Low suspicion (gestalt <15%): PE excluded if NONE of the 8 present",
    "items": [
      "Age ≥50",
      "HR ≥100",
      "SaO₂ <95%",
      "Haemoptysis",
      "Oestrogen use",
      "Surgery/trauma ≤4 weeks",
      "Previous DVT/PE",
      "Signs of DVT"
    ],
    "s": "PERC",
    "d": true
  },
  "interpretation_stg": [
    {
      "t": "Diagnosis is clinical, confirmed with imaging",
      "s": "HOSP:2.24",
      "level": "amber"
    },
    {
      "t": "Unstable confirmed PE: thrombolysis — discuss with specialist",
      "s": "HOSP:2.24",
      "level": "red"
    },
    {
      "t": "Rx: rivaroxaban 15 mg 12-hourly × 3 wk, then 20 mg daily × 3 months (check contraindications, Table 2.5)",
      "s": "HOSP:2.28",
      "level": "amber"
    },
    {
      "t": "Pregnancy: strong suspicion → enoxaparin 1 mg/kg SC 12-hourly + refer to confirm",
      "s": "MAT24:130",
      "level": "red"
    }
  ],
  "notes": [
    {
      "t": "Apply only after a history and examination suggest PE",
      "d": true
    },
    {
      "t": "Haemodynamically unstable → not a Wells problem: resuscitate, bedside echo, treat",
      "d": true
    },
    {
      "t": "Do not D-dimer 'likely' patients — go straight to imaging",
      "s": "NICE",
      "d": true
    },
    {
      "t": "PERC not validated in COVID-19",
      "s": "NICE",
      "d": true
    }
  ],
  "dagger_note": "d=true items are not in the SA STG (NICE NG158 / original papers).",
  "card_note": "✚ = SA STG / SA maternity guideline (pages listed above). Unmarked content: NICE NG158 and original papers. Wells is a pre-test probability tool — apply only after clinical suspicion of VTE."
