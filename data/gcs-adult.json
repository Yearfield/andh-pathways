  "formulas": [
    {
      "id": "gcs_total",
      "name": "GCS total",
      "expr": "GCS = E + V + M",
      "vars": {
        "E": "eye opening 1–4",
        "V": "verbal 1–5",
        "M": "motor 1–6"
      },
      "range": [
        3,
        15
      ],
      "notation": "Record components, e.g. E3 V4 M5 = 12",
      "s": "PHC:21.64"
    },
    {
      "id": "gcs_intubated",
      "name": "Intubated / aphasic",
      "expr": "GCS = E + M, V recorded as 'T' (e.g. E2 VT M4 = 6T)",
      "range": [
        2,
        10
      ],
      "notation": "suffix T; do not invent a V score",
      "s": null,
      "d": true
    }
  ],
  "interpretation_stg": [
    {
      "min": 3,
      "max": 8,
      "t": "Protect airway if GCS ≤8 (OP / opioid poisoning)",
      "s": "PHC:21.50",
      "level": "red",
      "c": "STG prints <8; corrected to ≤8"
    },
    {
      "min": 3,
      "max": 8,
