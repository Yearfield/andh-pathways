  "sofa_cns": {
    "t": "SOFA CNS points: GCS 15 = 0 · 13–14 = 1 · 10–12 = 2 · 6–9 = 3 · <6 = 4",
    "s": "HOSP:23.34",
    "c": "STG prints 10–11 (typo); corrected to 10–12"
  },
  "notes": [
    {
      "t": "Score the BEST response; if sides differ, use the better side",
      "d": true
    },
    {
      "t": "Pain stimulus: trapezius squeeze / supra-orbital pressure (central) for M; nail-bed (peripheral) for E",
      "d": true
    },
    {
      "t": "Always report components (E V M), not only the total; M is most predictive",
      "d": true
    },
    {
      "t": "Check glucose and exclude hypoxia, shock, drugs before attributing low GCS to brain injury",
      "d": true
    },
    {
      "t": "Fall of ≥2 points = deterioration → reassess ABC, escalate",
      "d": true
    }
  ],
  "dagger_note": "† = not in the SA STG (clinician craft or non-SA source). Lines with a page ref are STG. ‡ = STG misprint corrected (printed value given in JSON)."
