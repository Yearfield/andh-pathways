    "title": "PITFALLS",
    "items": [
     {
      "t": "~50% self-reduce and are missed — treat bicruciate instability as a dislocation",
      "s": "orthobullets:web",
      "d": 1,
      "b": 1
     },
     {
      "t": "Popliteal intimal tears occlude later — keep checking",
      "s": "msd:web",
      "d": 1
     },
     {
      "t": "Obesity: low-energy dislocations still injure the artery",
      "s": "msd:web",
      "d": 1
     },
     {
      "t": "Never send home the same day",
      "d": 1
     }
    ]
   }
