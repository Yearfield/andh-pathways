  "left": [
    {
      "type": "formula",
      "title": "Formulas",
      "items": [
        {
          "name": "CKD-EPI 2021 (adults, STG)",
          "expr": "142 × min(Scr/κ,1)^α × max(Scr/κ,1)^−1.200 × 0.9938^age × 1.012 [F]",
          "notes": "Scr mg/dL = µmol/L ÷ 88.4; κ 0.7 F / 0.9 M; α −0.241 F / −0.302 M; race-free",
          "s": "CKDEPI",
          "vars": {
            "Scr": "creatinine mg/dL",
            "age": "years",
            "sex": "M/F"
          },
          "units": "mL/min/1.73 m²"
        },
        {
          "name": "MDRD (IDMS)",
          "expr": "175 × Scr^−1.154 × age^−0.203 × 0.742 [F]",
          "notes": "Scr mg/dL; original × 1.212 if Black (not recommended)",
          "s": "MDRD",
          "units": "mL/min/1.73 m²"
        },
        {
          "name": "Cockcroft-Gault",
          "expr": "(140 − age) × weight × 1.23 [M] or 1.04 [F] ÷ Scr",
          "notes": "Scr µmol/L, weight kg → CrCl mL/min; drug dosing",
          "s": "CG",
          "units": "mL/min"
        },
        {
          "name": "Schwartz (children, STG)",
          "expr": "eCrCl = K × height (cm) ÷ creatinine (µmol/L)",
          "notes": "K: LBW <2.5 kg 30 · infant 0–8 mo 40 · girls 2–16 y 49 · boys 2–12 y 49 · boys 13–16 y 60",
          "s": "PAED:6.15",
          "units": "mL/min/1.73 m²"
        },
        {
          "name": "Urea:creatinine (SI)",
          "expr": "urea (mmol/L) ÷ creatinine (µmol/L) × 1000",
          "notes": ">100 suggests prerenal / UGIB; <40 intrinsic renal (approximate)",
          "units": "ratio"
        },
        {
          "name": "BUN:Cr (US)",
          "expr": "≈ SI ratio × 0.2475  (BUN mg/dL = urea mmol/L × 2.8)",
          "notes": ">20 prerenal"
        }
      ]
    },
    {
      "type": "list",
      "title": "Notes",
      "grow": true,
      "items": [
        {
          "t": "Use CKD-EPI for adults, Schwartz for children",
          "s": "HOSP:7.1"
        },
        {
          "t": "eGFR invalid in AKI (non-steady state), extremes of muscle mass, pregnancy"
        },
        {
          "t": "Schwartz K table has no value for 8 months–2 years; bedside Schwartz (2009) uses K = 36.5 for all ages",
          "c": true
        }
      ]
    }
