  "right": [
    {
      "type": "stg",
      "title": "SA STG — first aid & treatment",
      "items": [
        {
          "t": "Cool burns <3 h old with cold tap water ≥30 min; chemical burns: running water ≥30 min",
          "s": "HOSP:20.28",
          "level": "amber"
        },
        {
          "t": "Electrical burns: cardiac monitor; suspect compartment syndrome",
          "s": "HOSP:20.28",
          "level": "amber"
        },
        {
          "t": "≤10% TBSA: oral rehydration solution; >10%: NaCl 0.9% IV",
          "s": "HOSP:20.29",
          "level": "amber"
        },
        {
          "t": "Morphine IV (total max 10 mg) + paracetamol 0.5–1 g 4–6-hourly; tetanus toxoid 0.5 mL IM if not immunised in 5 y",
          "s": "HOSP:20.29",
          "level": "amber"
        },
        {
          "t": "Pantoprazole 40 mg IV daily; stop once tolerating enteral feeds",
          "s": "HOSP:20.29",
          "level": "amber"
        }
      ]
    },
    {
      "type": "stg",
      "title": "Discuss with burns specialist",
      "grow": true,
      "items": [
        {
          "t": ">15% TBSA, or >10% if age >50 years",
          "s": "HOSP:20.30",
          "level": "red"
        },
        {
          "t": "Face, hands, feet, genitalia, perineum, major joints; circumferential burns",
          "s": "HOSP:20.30",
          "level": "red"
        },
        {
          "t": "Electrical / lightning, chemical, inhalation injury; major trauma",
          "s": "HOSP:20.30",
          "level": "red"
        }
      ]
    }
