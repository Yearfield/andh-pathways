 "boxes": [
  {
   "title": "ASM doses (adult)",
   "items": [
    {
     "t": "Lamotrigine: 25 mg daily wk 1–2, 50 mg wk 3–4, then 100–200 mg/day (+50–100 mg every 1–2 wk)",
     "s": "adultstg2026:14.30"
    },
    {
     "t": "…with valproate: 25 mg alternate days wk 1–2, 25 mg daily wk 3–4, 100–200 mg/day",
     "s": "adultstg2026:14.30"
    },
    {
     "t": "…with enzyme inducers: 50 mg daily, 100 mg/day, then 200–400 mg/day",
     "s": "adultstg2026:14.30"
    },
    {
     "t": "Levetiracetam 250 mg 12-hourly → 500 mg 12-hourly; +500 mg 12-hourly every 2–4 wk (max 1 500 mg 12-hourly)",
     "s": "adultstg2026:14.31"
    },
    {
     "t": "Carbamazepine 100 mg 12-hourly; +100–200 mg/day weekly (max 600 mg 12-hourly)",
     "s": "adultstg2026:14.31"
    },
    {
     "t": "Valproate 200–300 mg 12-hourly (max 1 200 mg 12-hourly) — not in women",
     "s": "adultstg2026:14.31"
    },
    {
     "t": "Phenytoin 300 mg at night — only if already well controlled",
     "s": "adultstg2026:14.31"
    }
   ]
  },
  {
