      "items": [
        {
          "t": "Supports, never replaces, clinical judgement and serial examination",
          "s": "ALVARADO"
        },
        {
          "t": "Women of child-bearing age: pregnancy test first — exclude ectopic",
          "s": "ALVARADO"
        },
        {
          "t": "Less reliable in children (use PAS), pregnancy, the elderly and HIV",
          "s": "ALVARADO"
        },
        {
          "t": "Mnemonic MANTRELS = Migration, Anorexia, Nausea, Tenderness, Rebound, Elevated T, Leucocytosis, Shift",
          "s": "ALVARADO"
        }
      ]
