 "boxes": [
  {
   "title": "Electrolytes and special fluid plans",
   "items": [
    {
     "h": "Na 150–169: hypernatraemic dehydration",
     "s": "paedstg2024:2.16"
    },
    {
     "t": "Lower Na by ≤ 0.5 mmol/L/h (10–12 mmol/L per 24 h); falling > 1 mmol/L/h: slow the rate",
     "s": "paedstg2024:2.16"
    },
    {
     "t": "ORS/NGT 10 mL/kg/h preferred; continue feeds",
     "s": "paedstg2024:2.16"
    },
    {
     "t": "Volume = deficit 50–70 mL/kg + maintenance, over 48 h",
     "s": "paedstg2024:2.16"
    },
    {
     "t": "IV if oral/NGT fails: NaCl 0.9%/dextrose 5%: 2–10 kg 6 mL/kg/h · > 10–20 kg 5 · > 20–40 kg 4",
     "s": "paedstg2024:2.16"
    },
    {
     "t": "Maintenance: ≤ 1 y 120 mL/kg/24 h; > 1 y 100 / 50 / 20 mL/kg/24 h for 1st 10 / 2nd 10 / each kg > 20",
     "s": "paedstg2024:2.16"
    },
    {
     "h": "Na > 170: REFER (emergency)",
     "s": "paedstg2024:2.17"
    },
    {
     "t": "While waiting: 1 L NaCl 0.9% + 100 mL dextrose 50% + 10 mL KCl 15%, rate as above; phenobarbitone 20 mg/kg IV if convulsions likely",
     "s": "paedstg2024:2.17"
    },
    {
     "h": "Na < 120 or symptomatic",
     "s": "paedstg2024:2.17"
    },
    {
     "t": "NaCl 0.9% volume (mL) = (130 − Na) × wt × 4, at the rehydration rate: 200 mL NaCl 0.9% + 2 mL KCl 15% + 20 mL dextrose 50%",
     "s": "paedstg2024:2.17"
    },
    {
     "t": "K 2.5–3.5: KCl PO 25–50 mg/kg/dose 8-hourly",
     "s": "paedstg2024:2.15"
    },
    {
     "t": "K < 2.5: IV K only with continuous ECG + bedside K: REFER",
     "s": "paedstg2024:2.15",
     "b": 1
    },
    {
     "t": "pH < 7.1: bicarbonate only with expert supervision: discuss / REFER",
     "s": "paedstg2024:2.15",
     "b": 1
    }
   ]
