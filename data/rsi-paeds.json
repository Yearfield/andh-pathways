     "d": 1
    }
   ],
   "col": 2,
   "row": 1
  }
 ],
 "contraindications": [
  {
   "h": "RSI",
   "items": [
    {
     "t": "Most experienced clinician; juniors only under supervision",
     "s": "stg-paed:23.1"
    },
    {
     "t": "Plan for failed intubation is mandatory",
     "s": "stg-paed:23.1",
     "b": 1
    },
    {
     "t": "Difficult airway anticipated → senior / anaesthetist, Plans B–D open first",
     "d": 1
    },
    {
     "t": "Valid DNR / ceiling of care",
     "d": 1
    }
   ],
   "col": 1,
   "row": 1
  },
  {
   "h": "Suxamethonium – do NOT give (absolute)",
   "items": [
    {
     "t": "Chronic myopathy or denervating neuromuscular disease",
     "s": "stg-paed:23.3"
    },
    {
     "t": "48–72 h post burns, polytrauma or acute denervating event",
     "s": "stg-paed:23.3"
    },
    {
     "t": "Extensive rhabdomyolysis",
     "s": "stg-paed:23.3"
    },
    {
     "t": "Pre-existing hyperkalaemia",
     "s": "stg-paed:23.3",
     "b": 1
    },
    {
     "t": "Personal or family history of malignant hyperthermia",
     "s": "stg-paed:23.3",
     "b": 1
    }
   ],
   "col": 2,
   "row": 1
  },
  {
   "h": "Relative / not recommended",
