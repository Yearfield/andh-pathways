 "steps": [
  {
   "n": 1,
   "title": "PREPARE",
   "time": "T − 10 min",
   "subtitle": "checklist, team, monitors, access, equipment; plan for failure",
   "actions": [
    {
     "n": "1.1",
     "t": "Run the checklist and assess for a difficult airway",
     "x": "focused history and examination; roles: intubator · assistant · drug nurse · scribe/timer †",
     "s": "stg-paed:23.1"
    },
    {
     "n": "1.2",
     "t": "Attach monitors",
     "x": "3-lead ECG, automated BP, SpO₂, capnograph (EtCO₂), temperature",
     "s": "stg-paed:22.6"
    },
    {
     "n": "1.3",
     "t": "Secure IV access; IO if IV fails",
     "x": "IO is preferred to IM",
     "s": "stg-paed:23.2"
    },
    {
     "n": "1.4",
     "t": "Check age-appropriate equipment",
     "x": "ETT cuffed = age/4 + 3.5 mm; suction, 2 laryngoscopes, bougie, OPA/NPA, SGA, BVM sized to child; all checked before drugs †",
     "s": "stg-paed:22.8"
    },
    {
     "n": "1.5",
     "t": "Make the failure plan and say Plan A–D aloud",
     "x": "plan for unsuccessful intubation is mandatory; draw up and label drugs",
     "s": "stg-paed:23.1",
     "b": 1
    }
   ]
  },
  {
   "n": 2,
   "title": "PRE-OXYGENATE & OPTIMISE",
   "time": "T − 5 → T − 3 min",
   "subtitle": "100% oxygen as soon as the decision is made",
   "actions": [
    {
     "n": "2.1",
     "t": "Start 100% O₂ now",
     "x": "minimum 3 min raises the time to desaturation",
     "s": "stg-paed:23.1"
    },
    {
     "n": "2.2",
     "t": "Position",
     "x": "neutral head in toddlers, sniffing position in older children",
     "s": "stg-paed:1.9"
    },
    {
     "n": "2.3",
     "t": "Correct shock before drugs",
     "x": "hypovolaemic: 0.9% NaCl or Ringer's 20 mL/kg rapidly, review after each bolus; consider inotropes after 40 mL/kg",
     "s": "stg-paed:1.16"
    },
    {
     "n": "2.4",
     "t": "Weigh or estimate weight and say it aloud",
     "x": "read all doses from the table below",
     "d": 1
    },
    {
     "n": "2.5",
     "t": "Empty a distended stomach",
     "x": "NGT / OGT if needed",
     "d": 1
    }
   ],
   "decisions": [
    {
     "if": "Septic shock",
     "then": "10 mL/kg rapidly, review after each bolus; inotropes if not resolved after 40 mL/kg",
     "s": "stg-paed:1.17"
    },
    {
     "if": "SpO₂ falling or inadequate chest rise",
     "then": "bag-valve-mask: re-check head position and seal, add airway adjunct, exclude pneumothorax",
     "s": "stg-paed:1.9"
    }
   ]
  },
  {
   "n": 3,
   "title": "GIVE THE DRUGS IN THIS ORDER",
   "time": "T − 3 → T 0",
   "subtitle": "sedation always before the paralytic; pick ONE chain by condition",
   "actions": [],
   "pre": {
    "m": "a",
    "drug": "ATROPINE (optional)",
    "when": "T − 3 min",
    "dose": "0.02 mg/kg IV (min 0.1, max 0.5)",
    "adjusted": "if sux, infant, septic/late shock, or before ketamine",
    "s": "stg-paed:23.3"
   },
   "sequences": [
    {
     "id": "I",
     "label": "Ketamine",
     "note": "unstable, asthma, any state",
     "cells": [
      {
       "m": "b",
       "drug": "KETAMINE",
       "when": "T 0",
       "dose": "1–2 mg/kg IV",
       "adjusted": "60 s / lasts 5–10 min",
       "s": "stg-paed:23.3"
      },
      {
       "m": "c",
       "drug": "SUXAMETHONIUM",
       "when": "T 0, straight after b",
       "dose": "1–2 mg/kg IV push",
       "adjusted": "contra-indicated: ROCURONIUM 1 mg/kg IV",
       "s": "stg-paed:23.3"
      }
     ]
    },
    {
     "id": "II",
     "label": "Propofol",
     "note": "stable, head injury, seizure",
     "cells": [
      {
       "m": "b",
       "drug": "PROPOFOL",
       "when": "T 0",
       "dose": "1–3.5 mg/kg IV",
       "adjusted": "can produce hypotension",
       "s": "stg-paed:23.3"
      },
      {
       "m": "c",
       "drug": "SUXAMETHONIUM",
       "when": "T 0, straight after b",
       "dose": "1–2 mg/kg IV push",
       "adjusted": "contra-indicated: ROCURONIUM 1 mg/kg IV",
       "s": "stg-paed:23.3"
      }
     ]
    },
    {
     "id": "III",
     "label": "Etomidate",
     "note": "unstable, head injury",
     "cells": [
      {
       "m": "b",
       "drug": "ETOMIDATE",
       "when": "T 0",
       "dose": "0.3 mg/kg IV (max 20 mg)",
       "adjusted": "adrenal suppression; caution in sepsis",
       "s": "stg-paed:23.3"
      },
      {
       "m": "c",
       "drug": "SUXAMETHONIUM",
       "when": "T 0, straight after b",
       "dose": "1–2 mg/kg IV push",
       "adjusted": "contra-indicated: ROCURONIUM 1 mg/kg IV",
       "s": "stg-paed:23.3"
      }
     ]
    },
    {
     "id": "IV",
     "label": "Fentanyl",
     "note": "3 mcg/kg stable · 1 unstable",
     "cells": [
      {
       "m": "b",
       "drug": "FENTANYL",
       "when": "T 0",
       "dose": "3 mcg/kg IV (1 if unstable)",
       "adjusted": "give over 30–60 s",
       "s": "stg-paed:23.2"
      },
      {
       "m": "c",
       "drug": "SUXAMETHONIUM",
       "when": "T 0, straight after b",
       "dose": "1–2 mg/kg IV push",
       "adjusted": "contra-indicated: ROCURONIUM 1 mg/kg IV",
       "s": "stg-paed:23.3"
      }
     ]
    },
    {
     "id": "V",
     "label": "Midazolam",
     "note": "only if nothing else",
     "cells": [
      {
       "m": "b",
       "drug": "MIDAZOLAM",
       "when": "T 0",
       "dose": "0.2–0.3 mg/kg IV (max 10 mg)",
       "adjusted": "not recommended routinely",
       "s": "stg-paed:23.3"
      },
      {
       "m": "c",
       "drug": "SUXAMETHONIUM",
       "when": "T 0, straight after b",
       "dose": "1–2 mg/kg IV push",
       "adjusted": "contra-indicated: ROCURONIUM 1 mg/kg IV",
       "s": "stg-paed:23.3"
      }
     ]
    }
   ],
   "decisions": [
    {
     "if": "Normotensive",
     "then": "chain I, II, III or IV (V only if nothing else)",
     "s": "stg-paed:23.2"
    },
    {
     "if": "Hypotensive / hypovolaemic",
     "then": "chain I or III; chain IV at 1 mcg/kg is an option in instability",
     "s": "stg-paed:23.2"
    },
    {
     "if": "Head injury / status epilepticus",
     "then": "chain II, I or III; hypotensive → chain I or III",
     "s": "stg-paed:23.2"
    },
    {
     "if": "Status asthmaticus",
     "then": "chain I first (STG table also lists propofol, notes list etomidate)",
     "s": "stg-paed:23.2"
    }
   ],
   "sequence": [
    {
     "m": "a",
     "drug": "ATROPINE (optional)",
     "when": "T − 3 min",
     "dose": "0.02 mg/kg IV (min 0.1, max 0.5)",
     "adjusted": "if sux, infant, septic/late shock, or before ketamine",
     "s": "stg-paed:23.3"
    },
    {
     "m": "b",
     "drug": "KETAMINE",
     "when": "T 0",
     "dose": "1–2 mg/kg IV",
     "adjusted": "60 s / lasts 5–10 min",
     "s": "stg-paed:23.3"
    },
    {
     "m": "c",
     "drug": "SUXAMETHONIUM",
     "when": "T 0, straight after b",
     "dose": "1–2 mg/kg IV push",
     "adjusted": "contra-indicated: ROCURONIUM 1 mg/kg IV",
     "s": "stg-paed:23.3"
    }
   ]
  },
  {
   "n": 4,
   "title": "PARALYSE, INTUBATE & PROVE PLACEMENT",
   "time": "T 0 → T + 60 s",
   "subtitle": "view at 30 s, confirm at 45 s",
   "actions": [
    {
     "n": "4.1",
     "t": "Start the timer and wait for paralysis",
     "x": "sux 30–60 s; rocuronium 1–3 min",
     "s": "stg-paed:23.3"
    },
    {
     "n": "4.2",
     "t": "Position and view at 30 s",
     "x": "NO cricoid pressure; external laryngeal manipulation may improve the view",
     "s": "stg-paed:23.1",
     "b": 1
    },
    {
     "n": "4.3",
     "t": "Pass the tube",
     "x": "abort and re-oxygenate if SpO₂ or heart rate falls; max 3 attempts",
     "d": 1,
     "b": 1
    },
    {
     "n": "4.4",
     "t": "Confirm at 45 s",
     "x": "EtCO₂ strongly recommended + auscultation + symmetrical chest rise; no trace = wrong place",
     "s": "stg-paed:23.2",
     "b": 1
    },
    {
     "n": "4.5",
     "t": "Secure and set depth",
     "x": "oral depth at lips from table (1 y 12 cm · 2 y 14 · 6 y 16 · 10 y 18); cuff pressure 15–20 cmH₂O",
     "s": "stg-paed:22.8"
    }
   ],
   "decisions": [
    {
     "if": "Failed intubation (3 attempts or cannot oxygenate)",
     "then": "Plan B: SGA → Plan C: 2-person BVM + airway adjunct (sux wears off in 5–10 min) → Plan D: CICO, needle cricothyroidotomy in small children",
     "d": 1
    }
   ]
  },
  {
   "n": 5,
   "title": "SEDATE FIRST, THEN VENTILATE",
   "time": "T + 1 → T + 10 min",
   "subtitle": "analgesia first; sux lasts 5–10 min, ketamine 5–10 min",
   "actions": [
    {
     "n": "5.1",
     "t": "Give analgesia first",
     "x": "fentanyl 1–5 mcg/kg bolus then 1–4 mcg/kg/h, or morphine 0.05–0.3 mg/kg then 20–80 mcg/kg/h",
     "s": "stg-paed:23.5",
     "b": 1
    },
    {
     "n": "5.2",
     "t": "Then sedate",
     "x": "midazolam 0.05–0.2 mg/kg bolus then 50–200 mcg/kg/h",
     "s": "stg-paed:23.6",
     "b": 1
    },
    {
     "n": "5.3",
     "t": "Connect ventilator",
     "x": "volume or pressure control; Vt 6–8 mL/kg, PEEP 5, rate for age; start FiO₂ 1.0, titrate to SpO₂ >94%",
     "d": 1
    },
    {
     "n": "5.4",
     "t": "Monitor",
     "x": "ECG, BP, SpO₂, EtCO₂ continuous; ABG †; sedation with COMFORT-B every 4–8 h",
     "s": "stg-paed:23.4"
    },
    {
     "n": "5.5",
     "t": "Chest X-ray, settle and document",
     "x": "tube position; OGT/NGT, head-up 30°, record drugs, attempts, ETT size/depth; refer to paediatric ICU †",
     "s": "stg-paed:23.2"
    }
   ]
  }
 ],
