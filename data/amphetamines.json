     {
      "t": "CHILD: lorazepam 0.1 mg/kg IV (max 4) · or midazolam 0.25 mg/kg IV (max 10) / 0.5 mg/kg buccal · or diazepam 0.25 mg/kg IV (max 10)",
      "s": "paedstg2024:13.8"
     },
     {
