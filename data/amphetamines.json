     },
     {
      "t": "Or diazepam IV 5–10 mg (highest risk of respiratory depression)",
      "s": "stgah:20.15"
     },
     {
      "t": "Still not settled: olanzapine ODT/IM 5–10 mg",
      "s": "stgah:15.7"
