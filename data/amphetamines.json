     }
    ],
    "treatment": [
     {
      "h": "Agitation — ADULT"
     },
     {
      "t": "Oral first: lorazepam 0.5–2 mg · or clonazepam 0.5–2 mg · or diazepam 5–10 mg · or midazolam 7.5–15 mg oral/buccal",
      "s": "stgah:15.6"
     },
     {
      "t": "Refused / no response in 30–60 min: lorazepam IM 0.5–2 mg · or midazolam IM 7.5–15 mg",
