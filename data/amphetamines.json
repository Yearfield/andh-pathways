     },
     {
      "t": "Correct dehydration (IV crystalloid)",
      "s": "stgah:19.31"
     },
     {
      "t": "Rhabdomyolysis: IV fluids to keep urine flowing",
      "d": 1
     },
     {
      "t": "MDMA hyponatraemia: avoid excess free water",
      "d": 1
     },
     {
      "h": "Decontamination"
     },
     {
      "t": "Activated charcoal only if swallowed, within 1 h, airway protected — ADULT 50 g in 100 mL water",
      "s": "stgah:19.14"
     },
     {
      "t": "CHILD: activated charcoal < 6 y 1 g/kg; > 6 y 20–50 g",
      "s": "paedstg2024:18.4"
     }
