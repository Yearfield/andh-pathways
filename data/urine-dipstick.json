  "components": [
    {
      "key": "LEU",
      "name": "Leucocytes",
      "read": "2 min",
      "normal": "Negative",
      "items": [
        {
          "grade": "Neg",
          "colour": "#f3ead6"
        },
        {
          "grade": "Tr",
          "colour": "#e6d3d6"
        },
        {
          "grade": "+",
          "colour": "#c9a3c4"
        },
        {
          "grade": "++",
          "colour": "#a575ad"
        },
        {
          "grade": "+++",
          "colour": "#7d4a92"
        }
      ],
      "means": [
        {
          "t": "UTI; leucocytes only → repeat on a 2nd specimen",
          "s": "PHC:8.10",
          "d": false
        },
        {
          "t": "Sterile pyuria: renal TB, interstitial nephritis, calculi, urethritis",
          "s": "MSD",
          "d": true
        }
      ],
      "pitfalls": [
        {
          "t": "FP: vaginal contamination · FN: dilute urine, glycosuria, vit C, nitrofurantoin, rifampicin",
          "s": "MSD",
          "d": true
        }
      ]
    },
    {
      "key": "NIT",
      "name": "Nitrite",
      "read": "60 s",
      "normal": "Negative",
      "items": [
        {
          "grade": "Neg",
          "colour": "#fbf7f2"
        },
        {
          "grade": "Pos",
          "colour": "#f2a7bd"
        },
        {
          "grade": "Pos",
          "colour": "#e77fa1"
        }
      ],
      "means": [
        {
          "t": "Bacteriuria — usually Gram-negatives (E. coli, Klebsiella, Proteus)",
          "s": "MSD",
          "d": true
        },
        {
          "t": "Pregnancy: nitrites AND leucocytes → treat empirically",
          "s": "HOSP:6.32",
          "d": false
        }
      ],
      "pitfalls": [
        {
          "t": "FN: Enterococcus, GC, TB; urine < 4 h in bladder; vit C; pH < 6",
          "s": "MSD",
          "d": true
        }
      ]
    },
    {
      "key": "URO",
      "name": "Urobilinogen",
      "read": "60 s",
      "normal": "Normal trace",
      "items": [
        {
          "grade": "Norm",
          "colour": "#f6d3b8"
        },
        {
          "grade": "↑",
          "colour": "#f1aa9b"
        },
        {
          "grade": "↑↑",
          "colour": "#e98a8f"
        },
        {
          "grade": "↑↑↑",
          "colour": "#de6b86"
        }
      ],
      "means": [
        {
          "t": "↑ in haemolysis (with unconjugated hyperbilirubinaemia, ↑ LDH)",
          "s": "PAED:3.4",
          "d": false
        },
        {
          "t": "↑ hepatocellular disease; absent in complete biliary obstruction",
          "s": "CLASSIC",
          "d": true
        }
      ],
      "pitfalls": [
        {
          "t": "Neither sensitive nor specific — use LFTs",
          "s": "MSDLIV",
          "d": true
        }
      ]
    },
    {
      "key": "PRO",
      "name": "Protein",
      "read": "60 s",
      "normal": "Negative (Tr 0.15–0.3 · + 0.3–1 · ++++ > 5 g/L)",
      "items": [
        {
          "grade": "Neg",
          "colour": "#e9ea8f"
        },
        {
          "grade": "Tr",
          "colour": "#cfe08e"
        },
        {
          "grade": "+",
          "colour": "#a7d39c"
        },
        {
          "grade": "++",
          "colour": "#7fc2a6"
        },
        {
          "grade": "+++",
          "colour": "#56aeae"
        },
        {
          "grade": "++++",
          "colour": "#2f8f9e"
        }
      ],
      "means": [
        {
          "t": "≥ 1+ → repeat on MSU; if persistent → spot PCR (significant > 0.015 g/mmol)",
          "s": "PHC:8.3",
          "d": false
        },
        {
          "t": "Pregnancy ≥ 20 wk + BP ≥ 140/90: significant = ≥ 2+ on 2 samples ≥ 4 h apart → pre-eclampsia",
          "s": "MAT24:103",
          "d": false
        },
        {
          "t": "Nephrotic: child ≥ 3+ (PCR ≥ 0.2 g/mmol); adult PCR > 0.25 g/mmol",
          "s": "PHC:8.8",
          "d": false
        },
        {
          "t": "With blood: glomerulonephritis",
          "s": "HOSP:7.7",
          "d": false
        },
        {
          "t": "Transient: fever, exercise, UTI, orthostatic",
          "s": "CLASSIC",
          "d": true
        }
      ],
      "pitfalls": [
        {
          "t": "Albumin only — misses light chains (myeloma) · FP: pH > 9, contrast · FN: dilute urine",
          "s": "MSD",
          "d": true
        }
      ]
    },
    {
      "key": "PH",
      "name": "pH",
      "read": "60 s",
      "normal": "5.0–6.0 (range 4.5–8.0)",
      "items": [
        {
          "grade": "5",
          "colour": "#f19a5a"
        },
        {
          "grade": "6",
          "colour": "#f2c45c"
        },
        {
          "grade": "6.5",
          "colour": "#cfd16a"
        },
        {
          "grade": "7",
          "colour": "#9cc36e"
        },
        {
          "grade": "8",
          "colour": "#5fae8f"
        },
        {
          "grade": "8.5",
          "colour": "#3c8fa8"
        }
      ],
      "means": [
        {
          "t": "Alkaline: urease organisms (Proteus), stale sample",
          "s": "MSD",
          "d": true
        },
        {
          "t": "Alkaline: struvite stones, RTA, vomiting · Acid: acidosis/DKA, starvation",
          "s": "CLASSIC",
          "d": true
        }
      ],
      "pitfalls": [
        {
          "t": "Delayed processing ↑ pH (bacteria make ammonia)",
          "s": "MSD",
          "d": true
        }
      ]
    },
    {
      "key": "BLD",
      "name": "Blood",
      "read": "60 s",
      "normal": "Negative (exclude menses)",
      "items": [
        {
          "grade": "Neg",
          "colour": "#f2d36b"
        },
        {
          "grade": "Tr",
          "colour": "#cfd26d"
        },
        {
          "grade": "+",
          "colour": "#9fc36c"
        },
        {
          "grade": "++",
          "colour": "#6aa961"
        },
        {
          "grade": "+++",
          "colour": "#3f8a4f"
        }
      ],
      "means": [
        {
          "t": "Schistosomiasis (common), UTI, kidney stone (colic), anticoagulants",
          "s": "PHC:8.13",
          "d": false
        },
        {
          "t": "Painless isolated: bleeding disorder, malignancy, structural, TB (urine cytology, TB culture)",
          "s": "HOSP:7.17",
          "d": false
        },
        {
          "t": "Uniform colour, no RBCs on microscopy → haemolysis or rhabdomyolysis (CK)",
          "s": "MSD",
          "d": true
        }
      ],
      "pitfalls": [
        {
          "t": "Blood on the strip ≠ infection",
          "s": "PHC:8.13",
          "d": false
        },
        {
          "t": "FP: povidone-iodine · FN: vit C · red urine also: beetroot, rifampicin",
          "s": "MSD",
          "d": true
        }
      ]
    },
    {
      "key": "SG",
      "name": "Specific gravity",
      "read": "45 s",
      "normal": "1.001–1.035",
      "items": [
        {
          "grade": "1.000",
          "colour": "#1f6f78"
        },
        {
          "grade": "1.005",
          "colour": "#3d8a6d"
        },
        {
          "grade": "1.010",
