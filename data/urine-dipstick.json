        },
        {
          "grade": "+++",
          "colour": "#8a3d68"
        }
      ],
      "means": [
        {
          "t": "Adult DM with ketonuria > 1+ → urgent same-day referral",
          "s": "PHC:9.12",
          "d": false
        },
        {
          "t": "Child DKA: ketonuria 2+ with glucose > 11 mmol/L",
          "s": "PAED:7.19",
          "d": false
        },
        {
          "t": "Labour dehydration/ketosis; hyperemesis",
          "s": "HOSP:6.28",
          "d": false
        },
        {
          "t": "Starvation, alcoholic ketoacidosis, SGLT2i (euglycaemic DKA)",
          "s": "MSD",
          "d": true
        }
      ],
      "pitfalls": [
        {
          "t": "Misses β-hydroxybutyrate — use blood ketones · FN: vit C, NAC",
          "s": "MSD",
          "d": true
        }
      ]
    },
    {
      "key": "BIL",
      "name": "Bilirubin",
