  "colour_note": "Pad colours are illustrative — read against the bottle chart at the stated time.",
  "patterns": [
    {
      "t": "No LEU / NIT → UTI unlikely",
      "s": "PHC:8.10",
      "d": false
    },
    {
      "t": "LEU or NIT + UTI symptoms → treat; MC&S if possible",
      "s": "PHC:8.10",
      "d": false
    },
    {
      "t": "LEU + NIT → MC&S and treat empirically",
      "s": "PHC:8.10",
      "d": false
    },
    {
      "t": "Blood + protein, oedema, BP ↑, brown urine → nephritic: refer",
      "s": "PHC:8.8",
      "d": false
    },
    {
      "t": "Glucose + ketones → DKA until proven otherwise: HGT, blood ketones, VBG",
      "s": "HOSP:8.14",
      "d": false
    },
    {
      "t": "Bilirubin + with urobilinogen absent → obstructive jaundice",
      "s": "CLASSIC",
      "d": true
    }
  ],
  "pearls": [
    {
      "t": "Child with fever of unknown origin: always test urine (fresh bag specimen)",
      "s": "PHC:8.10",
      "d": false
    },
    {
      "t": "Bag urine = screening only; positive → aseptic sample (in-out catheter/SPA if ill < 2 y) for MCS",
      "s": "PAED:6.5",
      "d": false
    },
    {
      "t": "Haematuria > 1+ in hypertension → investigate",
      "s": "HOSP:3.38",
      "d": false
    },
    {
      "t": "Fresh midstream sample; read each pad at its stated time",
      "s": "CLASSIC",
      "d": true
    }
  ],
  "discrepancies": [
    {
      "t": "Significant proteinuria in pregnancy: MAT24 p.103 = ≥ 2+ on 2 occasions ≥ 4 h apart; PHC STG 6.14 = ≥ 1+. Card prints MAT24 (current maternity guideline).",
      "s": "MAT24:103",
      "d": false
    }
  ],
