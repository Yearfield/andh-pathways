        },
        {
          "t": "Pure haemolysis → negative (unconjugated is not excreted)",
          "s": "MSDLIV",
          "d": true
        }
      ],
      "pitfalls": [
        {
          "t": "FN: old sample, vit C — accuracy limited",
          "s": "MSDLIV",
          "d": true
        }
      ]
    },
    {
      "key": "GLU",
      "name": "Glucose",
      "read": "30 s",
      "normal": "Negative — any glucose is abnormal",
      "items": [
        {
          "grade": "Neg",
          "colour": "#7cc6d6"
        },
        {
          "grade": "Tr",
          "colour": "#8fc38a"
        },
        {
          "grade": "+",
          "colour": "#a9b65d"
        },
        {
          "grade": "++",
          "colour": "#b18f4a"
        },
        {
          "grade": "+++",
          "colour": "#8a5a35"
        }
      ],
      "means": [
        {
          "t": "Glycosuria → exclude diabetes mellitus",
          "s": "HOSP:3.38",
          "d": false
        },
        {
          "t": "Pregnancy ≥ 1+ on ≥ 2 occasions → GDM risk factor",
          "s": "HOSP:6.3",
          "d": false
        },
        {
          "t": "Child DKA: heavy glycosuria ≥ 3+",
          "s": "PAED:7.19",
          "d": false
        },
        {
          "t": "Normal plasma glucose: SGLT2 inhibitor, renal glycosuria, Fanconi",
          "s": "MSD",
          "d": true
        }
      ],
      "pitfalls": [
        {
          "t": "Appears when plasma glucose > ~10 mmol/L · FN: vit C, ketones, aspirin",
          "s": "MSD",
          "d": true
        }
      ]
    }
