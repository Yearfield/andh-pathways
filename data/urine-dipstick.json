        },
        {
          "grade": "1.020",
          "colour": "#9cb854"
        },
        {
          "grade": "1.030",
          "colour": "#c9c64e"
        }
      ],
      "means": [
        {
          "t": "High: dehydration, glucose/protein, contrast · Low: CKD, elderly",
          "s": "MSD",
          "d": true
        },
        {
          "t": "Low/fixed ~1.010: DI, water load, isosthenuria",
          "s": "CLASSIC",
          "d": true
        }
      ],
      "pitfalls": [
        {
          "t": "Dipstick ↑ if pH < 6, ↓ if pH > 7 — accuracy limited",
          "s": "MSD",
          "d": true
        }
      ]
    },
    {
      "key": "KET",
      "name": "Ketones",
