   "sequence_order": "",
   "decisions": [],
   "reference_refs": [
    0
   ]
  },
  {
   "n": 3,
   "title": "Feed — this is the maintenance fluid",
   "timing": "within 30 min",
   "time": "within 30 min",
   "subtitle": "F75 130 mL/kg/day",
   "actions": [
    {
     "n": "3.1",
     "t": "F75 130 mL/kg/day, 3-hourly (8 feeds)",
     "s": "stg-paed:2.45",
     "b": 1
    },
    {
     "n": "3.2",
     "t": "Gross oedema: start 100 mL/kg/day",
     "s": "stg-paed:2.45"
    },
    {
     "n": "3.3",
     "t": "Danger signs / hypothermia / hypoglycaemia: 2-hourly (12 feeds)",
     "s": "stg-paed:2.45"
    },
    {
     "n": "3.4",
     "t": "No mineral-vitamin complex: add KCl and Mg",
     "s": "stg-paed:2.41",
