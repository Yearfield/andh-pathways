   "title": "Check and treat glucose",
   "timing": "T 0 → T + 30 min",
   "time": "T 0 → T + 30 min",
   "subtitle": "BG <3 mmol/L",
   "actions": [
    {
     "n": "2.1",
     "t": "Well: F75 15 mL/kg or D10 10 mL/kg or sugar water 10 mL/kg PO",
     "s": "stg-paed:2.40"
    },
    {
     "n": "2.2",
     "t": "Symptomatic / persistent: D10 IV 5 mL/kg",
     "s": "stg-paed:2.40",
     "b": 1
    },
    {
     "n": "2.3",
     "t": "Recheck in 30 min; then 3-hourly × 24 h",
