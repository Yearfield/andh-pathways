   "n": 1,
   "title": "Shock only: cautious boluses",
   "timing": "T 0",
   "time": "T 0",
   "subtitle": "10 mL/kg over 20 min",
   "actions": [
    {
     "n": "1.1",
     "t": "Give NaCl 0.9% 10 mL/kg over 20 min",
     "s": "stg-paed:1.16",
     "s_more": [
      "stg-paed:2.11"
     ],
     "b": 1
    },
    {
     "n": "1.2",
     "t": "Reassess after each; max 4 boluses (40 mL/kg) → high care",
     "s": "stg-paed:2.11"
    },
    {
     "n": "1.3",
     "t": "Start ampicillin IV 50 mg/kg 6-hourly + gentamicin 6 mg/kg daily",
     "s": "stg-paed:2.18"
    }
   ],
   "sequence": [],
   "sequence_order": "",
   "decisions": [],
   "reference_refs": [
