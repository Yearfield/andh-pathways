   "n": 4,
   "title": "Rehydrate orally",
   "timing": "if needed",
   "time": "if needed",
   "subtitle": "as acute diarrhoea, more frequent checks",
   "actions": [
    {
     "n": "4.1",
     "t": "Use ORS / NGT per Dehydration card; avoid IV",
