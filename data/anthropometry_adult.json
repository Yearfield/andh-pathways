 "formulas": [
  {
   "id": "bmi",
   "name": "BMI",
   "expr": "weight_kg / (height_cm / 100)^2",
   "units": "kg/m²",
   "s": "PHC:3.13"
  },
  {
   "id": "ibw_m",
   "name": "Ideal / predicted body weight ♂",
   "expr": "50 + 0.91 × (height_cm − 152.4)",
   "units": "kg",
   "s": "MDCALC",
   "d": true
  },
  {
   "id": "ibw_f",
   "name": "Ideal / predicted body weight ♀",
   "expr": "45.5 + 0.91 × (height_cm − 152.4)",
   "units": "kg",
   "s": "MDCALC",
   "d": true
  },
  {
   "id": "abw",
   "name": "Adjusted body weight (BMI > 40, aminoglycosides)",
   "expr": "IBW + 0.4 × (weight_kg − IBW)",
   "units": "kg",
   "s": "HOSP:AII.1"
  },
  {
   "id": "bsa",
   "name": "BSA (Mosteller)",
   "expr": "sqrt(height_cm × weight_kg / 3600)",
   "units": "m²",
   "s": "HOSP:5.20"
  },
  {
   "id": "wt_loss",
   "name": "% weight loss",
   "expr": "(usual_weight − weight_kg) / usual_weight × 100",
   "units": "%",
   "s": "PHC:11.4"
  },
  {
   "id": "vt",
   "name": "Tidal volume",
   "expr": "5–8 mL × IBW (kg)",
   "s": "HOSP:23.47"
  }
 ],
 "interpretation_stg": [
